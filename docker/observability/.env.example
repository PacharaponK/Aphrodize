# Copy these settings into the deployment .env; never commit real credentials.
OBS_GRAFANA_USER=admin
OBS_GRAFANA_PASSWORD=replace-with-unique-password
OBS_GRAFANA_URL=http://localhost:3001
DISCORD_WEBHOOK_URL=
OBS_HOST=vm
OBS_EXPECTED_QUEUES=
OBS_MINIO_REQUIRED=true
OBS_UV_ENABLED=true
OBS_CADDY_ENABLED=true
OBS_FRONTEND_ENABLED=true
# For GPU metrics, establish private SSH tunnels to GPU loopback ports first.
# OBS_INFERENCE_TARGET=host.docker.internal:19101
# OBS_GPU_TARGET=host.docker.internal:19400
# GPU Alloy: LOKI_URL=http://host.docker.internal:13100/loki/api/v1/push
# External probe: run ONLY on a separate machine/provider.
# PROBE_URL=https://your-domain/api/health
