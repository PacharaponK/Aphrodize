                <mxCell id="120" value="&lt;b&gt;Aphrodize short overview&lt;/b&gt;&lt;br&gt;Consent + questionnaire → image-quality gate → face alignment → wrinkle segmentation → regional score/confidence → safety rules → category recommendation → history/trend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#4f86c6;fontColor=#1e3a8a;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="195" y="41.2" width="630" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="121" value="&lt;b&gt;MVP API contract&lt;/b&gt;&lt;br&gt;POST /consents • POST /questionnaires • POST /analyses&lt;br&gt;GET /analyses/{id} • GET /users/{id}/trends • DELETE /users/{id}/images • GET /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="195" y="110" width="455" height="39.2" as="geometry"/>
                </mxCell>
                <mxCell id="122" value="&lt;b style=&quot;line-height: 60%;&quot;&gt;User-visible result&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;line-height: 60%;&quot;&gt;&lt;li&gt;quality status&amp;nbsp;&lt;/li&gt;&lt;li&gt;wrinkle mask&amp;nbsp;&lt;/li&gt;&lt;li&gt;regional score&amp;nbsp;&lt;/li&gt;&lt;li&gt;confidence&amp;nbsp;&lt;/li&gt;&lt;li&gt;model version&lt;/li&gt;&lt;li&gt;possible factors from reported answers&amp;nbsp;&lt;/li&gt;&lt;li&gt;safe product category/active ingredient&lt;/li&gt;&lt;li&gt;qualified observations&amp;nbsp;&lt;/li&gt;&lt;li&gt;raw score + moving average&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#34d399;fontColor=#065f46;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="-230" y="130" width="230" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="123" value="&lt;b&gt;Safety boundary&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;line-height: 60%;&quot;&gt;&lt;li&gt;No age prediction&lt;/li&gt;&lt;li&gt;face recognition&lt;/li&gt;&lt;li&gt;diagnosis&lt;/li&gt;&lt;li&gt;causal claim&lt;/li&gt;&lt;li&gt;prescription&lt;/li&gt;&lt;li&gt;treatment guarantee.&lt;/li&gt;&lt;li&gt;Block low quality/confidence&lt;/li&gt;&lt;li&gt;allergy/irritation&lt;/li&gt;&lt;li&gt;contraindication&lt;/li&gt;&lt;li style=&quot;line-height: 120%;&quot;&gt;delete original + normalized + mask + linked results.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;fontColor=#881337;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="-230" y="300" width="230" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="124" value="&lt;b&gt;Open-source / free-plan stack&lt;/b&gt;&lt;br&gt;FastAPI • Pydantic • SQLAlchemy • PyTorch • MinIO • PostgreSQL • Redis/ARQ • Label Studio • MLflow • Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#78350f;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="-230" y="860" width="880" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="125" value="&lt;b&gt;Scale-out trigger&lt;/b&gt;&lt;br&gt;Keep the modular monolith for MVP. Add Redis + Celery/RQ worker only when GPU inference is too slow for the API process." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;dashed=1;" parent="1" vertex="1">
